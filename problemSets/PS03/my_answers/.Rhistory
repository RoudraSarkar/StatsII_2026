library(ggplot2)
library(dplyr)
# Load data
men <- read.csv("/Users/whiz/Downloads/data_20251201041644.csv")
# Remove unused columns
men <- men[ , !names(men) %in% c("X", "Unnamed..9", "Unnamed..10", "Unnamed: 9")]
# Convert types
men$PeriodCode <- as.numeric(men$PeriodCode)
men$Value <- as.numeric(men$Value)
eastern_europe <- c(
"Albania","Belarus","Bosnia and Herzegovina","Bulgaria","Croatia",
"Czech Republic","Estonia","Hungary","Kosovo","Latvia","Lithuania",
"Moldova","Montenegro","North Macedonia","Poland","Romania",
"Russia","Serbia","Slovakia","Slovenia","Ukraine"
)
western_europe <- c(
"Austria","Belgium","Denmark","Finland","France","Germany","Greece",
"Iceland","Ireland","Italy","Luxembourg","Malta","Netherlands",
"Norway","Portugal","Spain","Sweden","Switzerland","United Kingdom"
)
men <- men %>%
mutate(
Region = case_when(
CountryName %in% eastern_europe ~ "Eastern Europe",
CountryName %in% western_europe ~ "Western Europe",
TRUE ~ "Other"
)
)
ggplot(men, aes(x = PeriodCode, y = Value, group = CountryName)) +
# Eastern Europe = blue tones
geom_line(
data = subset(men, Region == "Eastern Europe"),
aes(color = CountryName),
linewidth = 0.9
) +
scale_color_manual(
values = setNames(
colorRampPalette(c("#a6cee3", "#1f78b4"))(
length(unique(men$CountryName[men$Region == "Eastern Europe"]))
),
unique(men$CountryName[men$Region == "Eastern Europe"])
),
guide = "none"
) +
# Western Europe = red tones
geom_line(
data = subset(men, Region == "Western Europe"),
aes(color = CountryName),
linewidth = 0.9
) +
scale_color_manual(
values = setNames(
colorRampPalette(c("#fb9a99", "#e31a1c"))(
length(unique(men$CountryName[men$Region == "Western Europe"]))
),
unique(men$CountryName[men$Region == "Western Europe"])
),
guide = "none"
) +
# Clear y-axis
scale_y_continuous(breaks = seq(20, 45, by = 5)) +
labs(
title = "Mean Age of Men at First Marriage (Europe)",
x = "Year",
y = "Mean Age"
) +
theme_minimal() +
theme(legend.position = "none")
