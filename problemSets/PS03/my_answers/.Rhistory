# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
# here is where you load any necessary packages
# ex: stringr
# lapply(c("stringr"),  pkgTest)
lapply(c("nnet", "MASS"),  pkgTest)
# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
library(nnet)
library(stargazer)
#####################
# Problem 1
#####################
# load data
gdp_data <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/main/datasets/gdpChange.csv", stringsAsFactors = F)
#dropping missing values
gdp_q1 <- na.omit(gdp_data[, c("GDPWdiff", "REG", "OIL")])
# creating 3 outcome categories for change in GDP
gdp_q1$GDPWdiff_cat <- ifelse(gdp_q1$GDPWdiff < 0, "negative",
ifelse(gdp_q1$GDPWdiff > 0, "positive", "no change"))
table(gdp_q1$GDPWdiff_cat)
# 1) Unordered multinomial logit Reference category: "no change"
gdp_q1$GDPWdiff_unordered <- relevel(
factor(trimws(gdp_q1$GDPWdiff_cat),
levels = c("no change", "negative", "positive")),
ref = "no change"
)
mnl_mod <- multinom(GDPWdiff_unordered ~ REG + OIL,
data = gdp_q1,
trace = FALSE)
summary(mnl_mod)
# coefficient table with z-statistics and p-values
mnl_sum  <- summary(mnl_mod)
mnl_coef <- mnl_sum$coefficients
mnl_se   <- mnl_sum$standard.errors
mnl_z    <- mnl_coef / mnl_se
mnl_p    <- 2 * (1 - pnorm(abs(mnl_z)))
mnl_results <- round(cbind(
Estimate = c(mnl_coef),
Std.Error = c(mnl_se),
z.value = c(mnl_z),
p.value = c(mnl_p)
), 4)
mnl_results
# category-specific intercepts and slopes
round(mnl_coef, 4)
# relative risk odds rations for category-specific slopes
exp(round(mnl_coef, 4))
# 2) Ordered multinomial logit Ordering
gdp_q1$GDPWdiff_ordered <- ordered(
trimws(gdp_q1$GDPWdiff_cat),
levels = c("negative", "no change", "positive")
)
ologit_mod <- polr(GDPWdiff_ordered ~ REG + OIL,
data = gdp_q1,
method = "logistic",
Hess = TRUE)
summary(ologit_mod)
# coefficient table with p-values
ologit_ct <- coef(summary(ologit_mod))
ologit_p  <- 2 * (1 - pnorm(abs(ologit_ct[, "t value"])))
ologit_results <- round(cbind(
ologit_ct,
p.value = ologit_p
), 4)
ologit_results
# ordered-logit cut points
round(ologit_mod$zeta, 4)
stargazer(
mnl_mod,
type = "latex",
title = "Unordered Multinomial Logit Model",
dep.var.labels = "GDPWdiff (ref. = no change)",
column.labels = c("negative vs no change", "positive vs no change"),
digits = 3,
single.row = FALSE
)
stargazer(
ologit_mod,
type = "latex",
title = "Ordered Multinomial Logit Model",
dep.var.labels = "GDPWdiff (negative < no change < positive)",
digits = 3,
single.row = FALSE
)
#####################
# Problem 2
#####################
# load data
mexico_elections <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/main/datasets/MexicoMuniData.csv")
# keep only variables needed for Q2 and drop missing values
mexico_q2 <- na.omit(mexico_elections[, c(
"PAN.visits.06",
"competitive.district",
"marginality.06",
"PAN.governor.06"
)])
# quick checks
summary(mexico_q2$PAN.visits.06)
table(mexico_q2$competitive.district)
table(mexico_q2$PAN.governor.06)
summary(mexico_q2$marginality.06)
############################
# Poisson regression
############################
pois_mod <- glm(
PAN.visits.06 ~ competitive.district + marginality.06 + PAN.governor.06,
data = mexico_q2,
family = poisson(link = "log")
)
# model summary
summary(pois_mod)
# coefficient table
pois_ct <- coef(summary(pois_mod))
pois_results <- round(cbind(
pois_ct,
IRR = exp(coef(pois_mod))
), 4)
pois_results
############################
# Part (a): test for competitive districts
############################
# Extract z-statistic and p-value for competitive.district
comp_z <- coef(summary(pois_mod))["competitive.district", "z value"]
comp_p <- coef(summary(pois_mod))["competitive.district", "Pr(>|z|)"]
comp_z
comp_p
############################
# Part (b): exponentiated coefficients / IRRs
############################
exp(coef(pois_mod))
############################
# Part (c): predicted mean number of visits competitive.district = 1; marginality.06 = 0; PAN.governor.06 = 1
############################
new_case <- data.frame(
competitive.district = 1,
marginality.06 = 0,
PAN.governor.06 = 1
)
# predicted expected count
predict(pois_mod, newdata = new_case, type = "response")
stargazer(
pois_mod,
type = "latex",
title = "Poisson Regression Model",
dep.var.labels = "PAN candidate visits in 2006",
digits = 3,
single.row = FALSE
)
