sum(
sqrt(2 * pi) / d *
exp(-((2 * (1:K) - 1)^2 * pi^2) / (8 * d^2))
)
}
#p-value (upper tail)
p_value <- 1 - ks_cdf(D, K)
return(list(
D_statistic = D,
p_value = p_value
))
}
