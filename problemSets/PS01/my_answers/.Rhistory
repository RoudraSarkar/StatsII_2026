ks_normal_test <- function(data, mu = 0, sigma = 1, K = 100) {
n <- length(data)
# sort data
x <- sort(data)
# empirical CDF
ECDF <- ecdf(x)
empiricalCDF <- ECDF(x)
# theoretical CDF (Normal)
theoreticalCDF <- pnorm(x, mean = mu, sd = sigma)
# KS statistic
D <- max(abs(empiricalCDF - theoreticalCDF))
# Kolmogorov-Smirnov CDF approximation
ks_cdf <- function(d, K = 100) {
sum(
sqrt(2 * pi) / d *
exp(-((2 * (1:K) - 1)^2 * pi^2) / (8 * d^2))
)
}
# p-value (upper tail)
p_value <- 1 - ks_cdf(D, K)
return(list(
D_statistic = D,
p_value = p_value
))
}
# Simulation
set.seed(123)
# Generate Cauchy data
data <- rcauchy(1000, location = 0, scale = 1)
# Run KS test against Normal(0,1)
result <- ks_normal_test(data)
# Print results
print(result)
#Data generation
set.seed(123)
data <- data.frame(
x = runif(200, 1, 10)
)
data$y <- 0 + 2.75 * data$x + rnorm(200, 0, 1.5)
# Negative log-likelihood for OLS
neg_log_likelihood <- function(par, x, y) {
beta0 <- par[1]
beta1 <- par[2]
sigma <- par[3]
if (sigma <= 0) return(Inf)
mu <- beta0 + beta1 * x
-sum(dnorm(y, mean = mu, sd = sigma, log = TRUE))
}
# Estimate using BFGS (quasi-Newton)
start_vals <- c(0, 1, 1)
bfgs_fit <- optim(
par = start_vals,
fn = neg_log_likelihood,
x = data$x,
y = data$y,
method = "BFGS"
)
#Estimate using lm()
lm_fit <- lm(y ~ x, data = data)
#Compare results
results <- data.frame(
Parameter = c("Intercept", "Slope", "Sigma"),
BFGS = c(
bfgs_fit$par[1],
bfgs_fit$par[2],
bfgs_fit$par[3]
),
LM = c(
coef(lm_fit)[1],
coef(lm_fit)[2],
summary(lm_fit)$sigma
)
)
print(results)
# Run KS test against Normal(0,1)
result <- ks_normal_test(data)
# remove objects
rm(list=ls())
