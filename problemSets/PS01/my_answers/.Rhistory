y = data$y,
method = "BFGS"
)
#Estimate using lm()
lm_fit <- lm(y ~ x, data = data)
#Compare results
results <- data.frame(
Parameter = c("Intercept", "Slope", "Sigma"),
BFGS = c(
bfgs_fit$par[1],
bfgs_fit$par[2],
bfgs_fit$par[3]
),
LM = c(
coef(lm_fit)[1],
coef(lm_fit)[2],
summary(lm_fit)$sigma
)
)
print(results)
