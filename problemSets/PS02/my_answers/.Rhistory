# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
lapply(c(),  pkgTest)
# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# load data
load(url("https://github.com/ASDS-TCD/StatsII_2026/blob/main/datasets/climateSupport.RData?raw=true"))
# 3. Inspect data
ls()                     # see object name
str(climateSupport)      # structure
summary(climateSupport)  # summary statistics
head(climateSupport)
# 4. Ensure variables are factors (important for regression)
climateSupport$countries <- factor(climateSupport$countries)
climateSupport$sanctions <- factor(climateSupport$sanctions)
# 5. Check balance of experimental treatments
table(climateSupport$countries)
table(climateSupport$sanctions)
# 6. Logistic regression model
model <- glm(choice ~ countries + sanctions,
data = climateSupport,
family = binomial(link = "logit"))
# 7. Model results
summary(model)
# 8. Odds ratios (easier interpretation)
exp(coef(model))
# 9. Predicted probabilities for each treatment combination
newdata <- expand.grid(
countries = levels(climateSupport$countries),
sanctions = levels(climateSupport$sanctions)
)
newdata$predicted_prob <- predict(model,
newdata = newdata,
type = "response")
print(newdata)
# 10. Plot predicted probabilities
plot(newdata$predicted_prob,
type = "b",
xaxt = "n",
xlab = "Policy Scenario",
ylab = "Predicted Probability of Support",
main = "Support for Climate Agreements")
axis(1, at = 1:nrow(newdata),
labels = paste(newdata$countries,
newdata$sanctions,
sep = " | "),
las = 2)
# check object name
ls()
str(climateSupport)
climateSupport$countries <- factor(climateSupport$countries)
climateSupport$sanctions <- factor(climateSupport$sanctions)
# Fit additive logistic regression
add_model <- glm(choice ~ countries + sanctions,
data = climateSupport,
family = binomial)
# Summary output (REPORT THIS)
summary(add_model)
null_model <- glm(choice ~ 1,
data = climateSupport,
family = binomial)
anova(null_model, add_model, test = "Chisq")
# Show coefficients
coef(add_model)
# Convert coefficients to odds ratios
exp(coef(add_model))
# Odds ratio comparing sanctions levels
OR_15_vs_5 <- exp(coef(add_model)["sanctions15%"] -
coef(add_model)["sanctions5%"])
OR_15_vs_5
# In additive model, effect is SAME regardless of countries
OR_15_vs_5
new_case <- data.frame(
countries = "80 of 192",
sanctions = "None"
)
pred_prob <- predict(add_model,
newdata = new_case,
type = "response")
pred_prob
# Fit interaction model
interaction_model <- glm(choice ~ countries * sanctions,
data = climateSupport,
family = binomial)
summary(interaction_model)
anova(add_model, interaction_model, test = "Chisq")
# If p-value < 0.05:
# If p-value < 0.05:
# interaction improves model → effects differ by countries
# Summary output (REPORT THIS)
summary(add_model)
