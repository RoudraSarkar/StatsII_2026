# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
lapply(c(),  pkgTest)
# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
graduation <- read.table("http://statmath.wu.ac.at/courses/StatsWithR/Powers.txt")
graduation <- read.table("http://statmath.wu.ac.at/courses/StatsWithR/Powers.txt")
str(graduation)
# Convert binary variables to factors
graduation$hsgrad  <- factor(graduation$hsgrad)
graduation$nonwhite <- factor(graduation$nonwhite)
graduation$mhs <- factor(graduation$mhs)
graduation$fhs <- factor(graduation$fhs)
graduation$intact <- factor(graduation$intact)
mod1 <- glm(
hsgrad ~ nonwhite + mhs + fhs + income + asvab + nsibs + intact,
data = graduation,
family = binomial(link = "logit")
)
summary(mod1)
mod0 <- glm(hsgrad ~ 1, data = graduation, family = binomial)
anova(mod0, mod1, test = "Chisq")
# Then construct 95-percent confidence intervals for the coefficients of the seven explanatory variables.
confint(mod1)
exp(cbind(OR = coef(mod1), confint(mod1)))
summary(mod1)
mod2 <- glm(
hsgrad ~ nonwhite + mhs + fhs + income + asvab + factor(nsibs) + intact,
data = graduation,
family = binomial
)
anova(mod1, mod2, test = "Chisq")
summary(mod1)
mod0 <- glm(hsgrad ~ 1, data = graduation, family = binomial)
anova(mod0, mod1, test = "Chisq")
# In the course of working this problem, you should discover an issue in the data.
table(graduation$nsibs)
# In the course of working this problem, you should discover an issue in the data.
table(graduation$nsibs)
# Deal with the issue in a reasonable manner.
graduation$nsibs_cat <- graduation$nsibs
graduation$nsibs_cat[graduation$nsibs >= 6] <- 6
graduation$nsibs_cat <- factor(graduation$nsibs_cat)
mod3 <- glm(
hsgrad ~ nonwhite + mhs + fhs + income + asvab + nsibs_cat + intact,
data = graduation,
family = binomial
)
# Does the result of the test change?
anova(mod1, mod3, test = "Chisq")
anova(mod0, mod1, test = "Chisq")
# Then construct 95-percent confidence intervals for the coefficients of the seven explanatory variables.
confint(mod1)
exp(cbind(OR = coef(mod1), confint(mod1)))
